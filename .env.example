# 科研雷达（ResearcherRadar）环境变量示例
#
# 使用方式：
# - 本地开发可以按需复制到自己的启动脚本或终端环境中。
# - 宝塔 / systemd / Supervisor 部署时，把这些变量配置到后端进程环境中。
# - VITE_* 变量需要写入 frontend/.env.production 后重新 npm run build。

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SQLITE_PATH=/www/wwwroot/researcher-radar/data/db.sqlite3
DJANGO_STATIC_ROOT=/www/wwwroot/researcher-radar/staticfiles
LITERATURE_HTTP_TIMEOUT=10
# OpenAlex 补抓：少量试用可不填 Key，长期运行建议申请免费 Key。
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENALEX_MIN_INTERVAL_SECONDS=0.25
OPENALEX_LOOKBACK_DAYS=14
OPENALEX_MAX_PAGES=3
# RSS/OpenAlex 失败时自动以 Crossref 期刊接口补抓（ScienceDirect RSS 可自动识别 ISSN）。
CROSSREF_JOURNAL_FALLBACK_ENABLED=true
CROSSREF_MAILTO=
CROSSREF_FALLBACK_LOOKBACK_DAYS=21
CROSSREF_FALLBACK_PUBLICATION_DAYS=60
CROSSREF_FALLBACK_MAX_PAGES=3
# 摘要备用：Semantic Scholar Key 可选；Elsevier Key 须有 ScienceDirect API 授权才会生效。
SEMANTIC_SCHOLAR_API_KEY=
ELSEVIER_API_KEY=
# 主源失败且 Crossref 未覆盖时，已授权 Elsevier Key 可按期刊名补抓。
ELSEVIER_FALLBACK_LOOKBACK_DAYS=21
ELSEVIER_FALLBACK_MAX_PAGES=2
# AI 速读优先使用“系统管理 -> AI 与 Zotero 设置”中保存的配置；以下环境变量仅作回退。
LITERATURE_AI_API_KEY=
LITERATURE_AI_MODEL=
LITERATURE_AI_BASE_URL=https://api.openai.com/v1
RSS_INGEST_ONLY_MATCHED=false
REPORT_MIN_RECOMMEND_SCORE=18
REPORT_SHOW_WEAK_RELATED=false
REPORT_MAX_PAPERS=80
SCORE_WEAK_THRESHOLD=8

# Zotero
# 也可以在网页端 系统管理 > AI 与 Zotero 设置 中保存，不一定要写环境变量。
ZOTERO_USER_ID=
ZOTERO_API_KEY=
ZOTERO_SYNC_STALE_SECONDS=3600

# Frontend build variables
VITE_API_BASE_URL=http://localhost:8000/api
VITE_ADMIN_URL=http://localhost:8000/admin/
# 仅在实际部署环境中填写；公开仓库不要写入具体备案号。
VITE_ICP_NUMBER=
